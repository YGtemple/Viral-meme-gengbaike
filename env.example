# 梗百科环境变量配置示例
# 复制为 .env 并填入你的 API Key

# ═══ LLM 提供商（至少配置一个）═══

# OpenAI
# OPENAI_API_KEY=sk-xxx

# DeepSeek（推荐，性价比高）
# DEEPSEEK_API_KEY=sk-xxx

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-xxx

# 通义千问
# DASHSCOPE_API_KEY=sk-xxx

# 豆包（字节火山引擎）
# ARK_API_KEY=your-ark-key

# 智谱 GLM
# ZHIPU_API_KEY=xxx

# Kimi 月之暗面
# MOONSHOT_API_KEY=sk-xxx

# 自定义 OpenAI 兼容端点
# CUSTOM_LLM_BASE_URL=https://your-endpoint/v1
# CUSTOM_LLM_API_KEY=sk-xxx
# CUSTOM_LLM_MODEL=your-model

# LLM 调用优先级（逗号分隔，失败自动切换）
# MEMECLAW_LLM_PRIORITY=deepseek,openai,qwen,ollama

# 覆盖指定提供商的默认模型
# DEEPSEEK_MODEL=deepseek-reasoner
# OPENAI_MODEL=gpt-4o
# QWEN_MODEL=qwen-max

# ═══ 搜索引擎（可选，不配置用免 Key 兜底）═══

# Tavily（推荐，AI 优化摘要）
# TAVILY_API_KEY=tvly-xxx

# SerpAPI
# SERPAPI_KEY=xxx

# Bing
# BING_API_KEY=xxx

# Brave
# BRAVE_API_KEY=xxx

# Google Custom Search
# GOOGLE_API_KEY=xxx
# GOOGLE_CSE_CX=xxx

# 搜索优先级
# MEMECLAW_SEARCH_PRIORITY=tavily,serpapi,baidu

# ═══ 系统配置 ═══

# MongoDB（可选，订阅和缓存需要）
# MONGO_URI=mongodb://localhost:27017

# 报告导出目录
# MEMECLAW_EXPORT_DIR=./data/reports
